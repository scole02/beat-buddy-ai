# Copy to .env, fill in credentials and a model available to your API account.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional: use another OpenAI-compatible endpoint. Keys stay on the backend.
# OPENAI_BASE_URL=https://api.openai.com/v1
COACH_API_MODE=responses
# Required for public hosting. Never commit the actual access code.
APP_PUBLIC=false
COACH_ACCESS_CODE=
# For providers that only implement Chat Completions: chat_completions
